# Nexxus.Intelligence Frontend Environment Variables
# In production on Vercel, set VITE_API_URL to your deployed Render API endpoint:
# e.g. https://nexxus-intelligence-api.onrender.com/api
VITE_API_URL=/api

# Optional: If client-side AI direct features are enabled
VITE_OPENAI_API_KEY=
VITE_GROQ_API_KEY=

