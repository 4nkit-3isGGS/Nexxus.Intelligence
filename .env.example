# =============================================================================
# NexxusDB — Criminal Network Analysis System (.env configuration)
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Neo4j Graph Database Configuration (Required for Live Graph Operations)
# -----------------------------------------------------------------------------
NEO4J_URL=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=passwordisneo4j
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5.0

# -----------------------------------------------------------------------------
# 2. Graph Data Source Mode
# Options:
#   - 'neo4j' : Query live Neo4j database (default for backend server)
#   - 'mock'  : Use in-memory offline mock graphs (for testing without Neo4j)
# -----------------------------------------------------------------------------
GRAPH_DATA_SOURCE=neo4j

# -----------------------------------------------------------------------------
# 3. Field-Level Cryptography & PII Protection (Law Enforcement Security)
# -----------------------------------------------------------------------------
# Master AES-256 Fernet key for encrypting sensitive PII (Aadhaar, PAN, Bank Details).
# Leave blank to use development fallback key, or generate a fresh key using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXXUS_MASTER_ENCRYPTION_KEY=

# Salt used for HMAC-SHA256 blind indexing for deterministic zero-knowledge querying.
NEXXUS_BLIND_INDEX_SALT=NEXXUS_INDIAN_LAW_ENFORCEMENT_SALT_2026

# -----------------------------------------------------------------------------
# 4. Backend Server Settings
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 5. Groq LLM Cloud Engine (Ultra-Fast Llama-3.3-70B Multi-Agent Reasoning)
# -----------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# 6. Local LLM / Ollama Engine (Optional Offline Reasoning)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral



